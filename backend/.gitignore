# ==========================================
# draftva: Backend .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Databases
*.db
*.sqlite
*.sqlite3
draftva.db

# Test & coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log
