# Copy to backend/.env on the server. NEVER commit the real file.
# scripts/init-production-env.py generates the first four secrets, without printing them.
APP_ENV=production
APP_SECRET=
POSTGRES_PASSWORD=
AUTH_PROXY_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql+psycopg://app:${POSTGRES_PASSWORD}@postgres:5432/draftva
REDIS_URL=redis://redis:6379/0
WEB_CONCURRENCY=2
NGINX_CONFIG=https
PROXY_NETWORK_SUBNET=172.29.250.0/28
PROXY_NETWORK_DYNAMIC_RANGE=172.29.250.8/29
NGINX_PROXY_IP=172.29.250.2
FORWARDED_ALLOW_IPS=172.29.250.2

FRONTEND_URL=https://draftva.com
PUBLIC_BACKEND_URL=https://api.draftva.com
CORS_ORIGINS=https://draftva.com
OAUTH_REDIRECT_BASE_URL=https://api.draftva.com/api/v1/channels/{platform}/callback
EMAIL_VERIFICATION_REQUIRED=true
RATE_LIMIT_ENABLED=true
SESSION_TTL_DAYS=30
RESEND_API_KEY=
RESEND_FROM_EMAIL=Draftva <noreply@draftva.com>
MAIL_FROM=Draftva <noreply@draftva.com>
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

GOOGLE_CLIENT_ID=
X_LOGIN_CLIENT_ID=
X_LOGIN_CLIENT_SECRET=
X_LOGIN_REDIRECT_URI=https://draftva.com/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=draftva:v1.0 (by /u/YOUR_REDDIT_USERNAME)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.draftva.com/api/v1/channels/facebook/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.draftva.com/api/v1/channels/instagram/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://api.draftva.com/api/v1/channels/threads/callback
BLUESKY_CLIENT_ID=
BLUESKY_PRIVATE_KEY=
BLUESKY_KEY_ID=draftva-1

DODO_API_BASE=https://live.dodopayments.com
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_RETURN_URL=https://draftva.com/settings/billing
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
# Each non-monthly cycle needs a separate recurring Dodo product ID.
DODO_PRODUCT_STARTER_QUARTERLY=
DODO_PRODUCT_STARTER_ANNUALLY=
DODO_PRODUCT_PRO_QUARTERLY=
DODO_PRODUCT_PRO_ANNUALLY=
DODO_PRODUCT_BUSINESS_QUARTERLY=
DODO_PRODUCT_BUSINESS_ANNUALLY=
DODO_PRODUCT_BUSINESS=
BILLING_RECONCILE_INTERVAL_SECONDS=3600
BILLING_RECONCILE_BATCH_SIZE=200
BILLING_RECONCILE_MAX_REQUESTS=20
BILLING_RECONCILE_TIME_BUDGET_SECONDS=30

LLM_MOCK_ENABLED=false
LLM_PROVIDER_URL=
LLM_PROVIDER_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=4096
LLM_COST_MICROS_PER_TOKEN=5
X_MONTHLY_SPEND_LIMIT_MICROS=10000000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
MEDIA_MAX_BYTES=20971520
VIDEO_MAX_BYTES=104857600
MEDIA_WORKSPACE_QUOTA_BYTES=1073741824
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
