APP_ENV=development
API_PORT=18000
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./draftva.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_DAYS=30
OAUTH_REDIRECT_BASE_URL=http://localhost:18000/api/v1/channels/{platform}/callback

# Google Auth
GOOGLE_CLIENT_ID=
# X sign-in: OAuth 2.0 Web App credentials, separate from publishing X_CLIENT_*.
X_LOGIN_CLIENT_ID=
X_LOGIN_CLIENT_SECRET=
# Defaults to FRONTEND_URL/api/auth/x/callback. Register that exact URL in X.
X_LOGIN_REDIRECT_URI=
EMAIL_VERIFICATION_REQUIRED=true
# Same server-only random value in backend/.env and fronted/.env.
AUTH_PROXY_SECRET=
# Uvicorn proxy IPs/CIDRs; empty trusts no forwarded headers. Never use * on a public origin.
FORWARDED_ALLOW_IPS=
# Secure OTPs are generated/verified in Draftva and delivered through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Draftva <noreply@draftva.com>
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Channels OAuth credentials
X_CLIENT_ID=
X_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=draftva:v0.1.0 (by /u/draftva_app)

BLUESKY_CLIENT_ID=

# Meta/Facebook app credentials (Facebook Pages only)
# Set each redirect URI to the EXACT HTTPS URI registered for its login product.
# Leave blank to use OAUTH_REDIRECT_BASE_URL for that platform.
FACEBOOK_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram > API setup with Instagram login: Instagram App ID and secret
# These are a separate credential pair; Facebook credentials are never a fallback.
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Billing (Dodo Payments)
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
BILLING_RECONCILE_INTERVAL_SECONDS=3600
BILLING_RECONCILE_BATCH_SIZE=200
BILLING_RECONCILE_MAX_REQUESTS=20
BILLING_RECONCILE_TIME_BUDGET_SECONDS=30
BILLING_RECONCILE_REQUEST_INTERVAL_SECONDS=1
BILLING_RECONCILE_HTTP_TIMEOUT_SECONDS=10
BILLING_RECONCILE_RETRY_BASE_SECONDS=60
BILLING_RECONCILE_RETRY_MAX_SECONDS=3600
DODO_API_BASE=https://test.dodopayments.com
BILLING_CATALOG_CACHE_TTL_SECONDS=60
BILLING_CATALOG_TIMEOUT_SECONDS=8
DODO_RETURN_URL=http://localhost:3000/settings/billing
DODO_PRODUCT_STARTER=
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=
# Each non-monthly cycle needs a separate recurring Dodo product ID.
DODO_PRODUCT_STARTER_QUARTERLY=
DODO_PRODUCT_STARTER_ANNUALLY=
DODO_PRODUCT_PRO_QUARTERLY=
DODO_PRODUCT_PRO_ANNUALLY=
DODO_PRODUCT_BUSINESS_QUARTERLY=
DODO_PRODUCT_BUSINESS_ANNUALLY=
DODO_PRODUCT_AGENCY=
DODO_PRODUCT_CREATOR=

# AI Assistant
LLM_PROVIDER_URL=
LLM_PROVIDER_API_KEY=
LLM_MODEL=

WORKER_POLL_SECONDS=5
SCHEDULER_POLL_SECONDS=10

# Media & Storage (Cloudflare R2 / S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
MEDIA_MAX_BYTES=20971520
VIDEO_MAX_BYTES=104857600
MEDIA_URL_TTL_SECONDS=900

RATE_LIMIT_ENABLED=true
BILLING_GRACE_DAYS=3

# Optional dedicated Fernet key and comma-separated old keys for rotation
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
LINKEDIN_API_VERSION=202609
# Request analytics scopes only after LinkedIn approves them for this app.
# Member post analytics needs r_member_postAnalytics. Page post analytics needs
# rw_organization_admin and an Admin role on the Page.
# LINKEDIN_SCOPES=openid,profile,email,w_member_social,r_member_postAnalytics,w_organization_social,r_organization_social,rw_organization_admin
GRAPH_API_VERSION=v23.0
GRAPH_INSIGHTS_API_VERSION=v26.0
THREADS_APP_ID=
THREADS_APP_SECRET=
# Exact HTTPS callback registered under the Threads API settings. Localhost is unsupported.
THREADS_REDIRECT_URI=
BLUESKY_PRIVATE_KEY=
BLUESKY_KEY_ID=draftva-1
LLM_MOCK_ENABLED=false
LLM_MAX_OUTPUT_TOKENS=4096
LLM_COST_MICROS_PER_TOKEN=5
X_MONTHLY_SPEND_LIMIT_MICROS=10000000
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=draftva <noreply@draftva.ai>
PUBLIC_BACKEND_URL=http://localhost:18000

# Temporary shared analytics results and read protection (Redis; no SQL metric cache)
ANALYTICS_CACHE_TTL_SECONDS=300
ANALYTICS_REFRESH_COOLDOWN_SECONDS=60
ANALYTICS_MAX_PAGES_PER_ACCOUNT=5
ANALYTICS_MAX_POSTS_PER_ACCOUNT=500
ANALYTICS_MAX_READS_PER_REFRESH=100
ANALYTICS_DAILY_READ_LIMIT=1000
ANALYTICS_REFRESH_TIMEOUT_SECONDS=50
ANALYTICS_CACHE_MAX_BYTES=5000000
# Storage reservations include unfinished uploads; ready files are retained.
MEDIA_WORKSPACE_QUOTA_BYTES=1073741824
MEDIA_PENDING_TTL_HOURS=24
MEDIA_CLEANUP_BATCH_SIZE=100
