BASE_API=http://localhost:18000
# Must match backend AUTH_PROXY_SECRET; never use a NEXT_PUBLIC_ prefix.
AUTH_PROXY_SECRET=
# Header your trusted reverse proxy overwrites with the real visitor IP.
# Block direct origin access / strip spoofed headers at that proxy in production.
AUTH_CLIENT_IP_HEADER=x-forwarded-for

# Required for server-rendered tRPC queries; use your actual HTTPS frontend origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
