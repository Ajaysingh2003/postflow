# ==========================================
# postflow: Root .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# Python & Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite & Local Databases
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
postflow.db

# Testing, Coverage & Linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ------------------------------------------
# Frontend & Node.js
# ------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------
# Operating System & Editors
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
logs/
tmp/
temp/
